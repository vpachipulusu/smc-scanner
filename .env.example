# All optional. With none set, the scanner attaches to the MT5 terminal already running
# and logged in on this machine. Copy to .env to let it start/log in to the terminal itself.
# Names only: never commit real values.
#
# Use the account's INVESTOR (read-only) password, never the master password. The code
# never trades, but a read-only login is the only guarantee that survives a code change.
# The same applies to a terminal you leave logged in for the scanner to attach to.
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional: watchlist path (default ./watchlist.yaml) and API host allow-list.
SMC_WATCHLIST=
SMC_API_ALLOWED_HOSTS=127.0.0.1,localhost

# API access. When SMC_INTERNAL_KEY is set every request needs a matching X-Internal-Key
# header; UNSET MEANS OPEN. Set it whenever the API is reachable beyond loopback. Set
# SMC_API_HOST (or UVICORN_HOST) to the address you bind to so startup can warn about that.
SMC_INTERNAL_KEY=
SMC_API_HOST=

# AI analysis (Claude). Required for --ai and POST /analyse.
ANTHROPIC_API_KEY=
# Optional tuning: AI_PROVIDER (only "claude"), AI_MODEL, AI_TIMEOUT_SECONDS, AI_MAX_RETRIES,
# AI_TEMPERATURE, AI_BASE_URL.
AI_PROVIDER=
AI_MODEL=
AI_TIMEOUT_SECONDS=
AI_MAX_RETRIES=
AI_TEMPERATURE=
AI_BASE_URL=
# Daily spend caps (UTC day). Blank means unlimited; an invalid value makes the API answer 503.
AI_MAX_CALLS_PER_DAY=
AI_MAX_COST_PER_DAY=

# SQLite file for analyses, schedules, alerts and the job log (default ./smc.db).
SMC_DB_PATH=

# Scheduler (opt-in): 1/true/yes/on enables it. Run ONE uvicorn worker.
SMC_SCHEDULER=
# Broker server time zone (IANA name, e.g. Europe/Athens) for 4h/1d schedules. Blank is UTC.
SMC_SERVER_TZ=

# Telegram alerts. TELEGRAM_CHAT_ID is the default chat for schedules without their own.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
