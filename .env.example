# All optional. With none set, the scanner attaches to the MT5 terminal already running
# and logged in on this machine. Copy to .env to let it start/log in to the terminal itself.
#
# Use the account's INVESTOR (read-only) password, never the master password. The code
# never trades, but a read-only login is the only guarantee that survives a code change.
# The same applies to a terminal you leave logged in for the scanner to attach to.
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional: watchlist path (default ./watchlist.yaml) and API host allow-list.
SMC_WATCHLIST=
SMC_API_ALLOWED_HOSTS=127.0.0.1,localhost
