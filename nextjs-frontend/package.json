    "lucide-react": "^0.563.0",
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.95.0",
    "@playwright/test": "~1.58.0",
